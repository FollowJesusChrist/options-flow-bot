# Copy to .env and fill in. NEVER commit .env.
# Tradier: free account at https://tradier.com -> API access.
#   Production token = real-time data. Sandbox token = delayed/dummy data,
#   free for development.

TRADIER_TOKEN=
# TRADIER_BASE defaults to sandbox. Set to https://api.tradier.com/v1 for production.
TRADIER_BASE=https://sandbox.tradier.com/v1

# Discord bot token for scan alerts. Create at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
DISCORD_ALERT_CHANNEL_ID=

# Discord bot token for the /chart command (can be the same bot or a separate one)
CHART_DISCORD_BOT_TOKEN=
# Your Discord server ID + the channel /chart answers in
CHART_GUILD_ID=
CHART_CHANNEL_ID=

# Channel for one-off test posts (scripts/test-*.mjs)
DISCORD_TEST_CHANNEL_ID=
